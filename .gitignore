# MySQL dumps — but never the schema itself: Flyway migrations and the container's DB
# bootstrap are source, and a clone without them cannot bring the stack up.
*.sql
!**/src/main/resources/db/migration/*.sql
!database/init/*.sql
!database/migrations/**/*.sql

