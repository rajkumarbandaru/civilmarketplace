# =============================================================================
# Civil Engineering Marketplace - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# Do NOT commit the .env file to version control
# =============================================================================

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=civil_engineer_platform

# --- Service Database Credentials ---
AUTH_DB_USERNAME=civil_user
AUTH_DB_PASSWORD=civil_pass
USER_DB_USERNAME=civil_user
USER_DB_PASSWORD=civil_pass
BOOKING_DB_USERNAME=civil_user
BOOKING_DB_PASSWORD=civil_pass
PAYMENT_DB_USERNAME=civil_user
PAYMENT_DB_PASSWORD=civil_pass
NOTIFICATION_DB_USERNAME=civil_user
NOTIFICATION_DB_PASSWORD=civil_pass
ADMIN_DB_USERNAME=civil_user
ADMIN_DB_PASSWORD=civil_pass

# --- JWT Configuration ---
# Generate with: openssl rand -base64 64
JWT_SECRET=base64_encoded_secret_key_minimum_256_bits_change_me

# --- Razorpay Configuration ---
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# --- Notification channels ---
# Each channel takes its real provider or `log`. With `log`, the message is written to the
# notification-service log and nothing leaves the cluster. Values left as the templates below
# are detected as placeholders and fall back to logging regardless of the provider setting,
# so a half-configured environment never breaks OTP login.
EMAIL_PROVIDER=smtp
SMS_PROVIDER=twilio
WHATSAPP_PROVIDER=twilio

# --- Email/SMTP Configuration ---
# Gmail requires an App Password (Google Account > Security > 2-Step Verification >
# App passwords), not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Brevo: the SMTP *login* from Brevo > SMTP & API > SMTP (often <id>@smtp-brevo.com),
# not your account email and not the API key.
SMTP_USERNAME=your_email@gmail.com
# Must be a sender you have verified on the relay account, or it rejects every send.
EMAIL_FROM_ADDRESS=noreply@civilengineer.com
EMAIL_FROM_NAME=Civil Engineer Marketplace
SMTP_PASSWORD=your_app_password

# Brevo HTTP API — an alternative to the SMTP relay above, needing only this one key.
# Set EMAIL_PROVIDER=brevo to use it.
BREVO_API_KEY=xkeysib-XXXXXXXX

# --- Twilio SMS Configuration ---
# Account SID is `AC` + 32 hex digits; the auth token is 32 hex digits. Both come from the
# Twilio console dashboard.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+1234567890
# Accounts store bare national numbers; this is prepended to reach the E.164 Twilio requires.
SMS_DEFAULT_COUNTRY_CODE=+91
SMS_SENDER_ID=CIVILENG

# --- Twilio WhatsApp Configuration ---
# Uses the same account SID/auth token as SMS above. The default is Twilio's shared sandbox
# number, which only delivers to numbers that have joined your sandbox; replace it with your
# approved WhatsApp Business sender for production.
TWILIO_WHATSAPP_FROM=+14155238886

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- RabbitMQ Configuration ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- Elasticsearch Configuration ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# --- Google OAuth2 Configuration ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
# Public base URL of the api-gateway, used to build the OAuth2 callback URL.
OAUTH2_GATEWAY_BASE_URL=http://localhost:8087
# Set to "docker,social" to enable Google/Facebook login (needs real credentials above).
AUTH_PROFILE=docker

# --- Apple OAuth2 Configuration ---
APPLE_CLIENT_ID=your.apple.client.id
APPLE_CLIENT_SECRET=your_apple_client_secret
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id

# --- Firebase Configuration ---
FIREBASE_CONFIG_PATH=/etc/config/firebase-service-account.json

# --- Zipkin Configuration ---
ZIPKIN_BASE_URL=http://zipkin:9411

# --- Grafana Configuration ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Google Maps ---
# Browser key used by the frontend (baked in at build time as VITE_GOOGLE_MAPS_API_KEY).
GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# --- Ask AI assistant (Google Gemini) ---
# Free key from https://aistudio.google.com/apikey — no card required.
# Read by support-service only; never expose it through a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the primary answers 503 "high demand" or 404 "retired model".
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
# Quote registered providers' own rates alongside market rates in estimates, and how long the
# rate card read from search-service is reused for.
AI_SITE_RATES_ENABLED=true
AI_SITE_RATES_CACHE_SECONDS=600
AI_ASSISTANT_ENABLED=true
