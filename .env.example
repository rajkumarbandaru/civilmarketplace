# =============================================================================
# Civil Engineering Marketplace - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# Do NOT commit the .env file to version control
# =============================================================================

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=civil_engineer_platform

# --- Service Database Credentials ---
AUTH_DB_USERNAME=civil_user
AUTH_DB_PASSWORD=civil_pass
USER_DB_USERNAME=civil_user
USER_DB_PASSWORD=civil_pass
BOOKING_DB_USERNAME=civil_user
BOOKING_DB_PASSWORD=civil_pass
PAYMENT_DB_USERNAME=civil_user
PAYMENT_DB_PASSWORD=civil_pass
NOTIFICATION_DB_USERNAME=civil_user
NOTIFICATION_DB_PASSWORD=civil_pass
ADMIN_DB_USERNAME=civil_user
ADMIN_DB_PASSWORD=civil_pass

# --- JWT Configuration ---
# Generate with: openssl rand -base64 64
JWT_SECRET=base64_encoded_secret_key_minimum_256_bits_change_me

# --- Razorpay Configuration ---
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# --- Email/SMTP Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# --- Twilio SMS Configuration ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+1234567890

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- RabbitMQ Configuration ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- Elasticsearch Configuration ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# --- Google OAuth2 Configuration ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Apple OAuth2 Configuration ---
APPLE_CLIENT_ID=your.apple.client.id
APPLE_CLIENT_SECRET=your_apple_client_secret
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id

# --- Firebase Configuration ---
FIREBASE_CONFIG_PATH=/etc/config/firebase-service-account.json

# --- Zipkin Configuration ---
ZIPKIN_BASE_URL=http://zipkin:9411

# --- Grafana Configuration ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
